<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/hawklyx_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row: Prominent Brand Emblem, Instrument Title Stack, Dynamic Status Badge -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Prominent Brand Emblem: enlarged to 34dp -->
        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/hawklyx_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:text="HAWKLYX"
                android:textColor="@color/hawklyx_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="BRENT CRUDE INTELLIGENCE"
                android:textColor="@color/hawklyx_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dynamic Status Badge Pill -->
        <TextView
            android:id="@+id/widget_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hawklyx_badge_emerald"
            android:letterSpacing="0.06"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:text="@string/status_fresh"
            android:textColor="@color/hawklyx_emerald"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Metrics Row: Dominant Price, Unit, and 7-Day Change / Trend Indicator Pill -->
    <LinearLayout
        android:id="@+id/widget_price_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:text="--.--"
            android:textColor="@color/hawklyx_emerald"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="3dp"
            android:letterSpacing="0.02"
            android:text="@string/unit_usd_bbl"
            android:textColor="@color/hawklyx_text_secondary"
            android:textSize="11sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/widget_trend_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:background="@drawable/hawklyx_card_surface"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/widget_change"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:text="7D TREND"
                android:textColor="@color/hawklyx_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chart Frame: Layered surface taking remaining vertical space -->
    <FrameLayout
        android:id="@+id/widget_chart_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="4dp"
        android:layout_weight="1"
        android:background="@drawable/hawklyx_card_surface"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_chart_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_intelligence_description"
            android:scaleType="fitXY" />

        <LinearLayout
            android:id="@+id/widget_chart_empty_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_chart_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.04"
                android:text="@string/history_accumulating"
                android:textColor="@color/hawklyx_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_chart_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/history_empty_note"
                android:textColor="@color/hawklyx_text_muted"
                android:textSize="9.5sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Footer Row: Last observation timestamp, status message, and refresh affordance -->
    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Awaiting first sync"
                android:textColor="@color/hawklyx_text_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_status_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="7-Day Authentic Market Trend"
                android:textColor="@color/hawklyx_text_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/hawklyx_card_surface"
            android:contentDescription="@string/tap_to_refresh"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

</LinearLayout>
